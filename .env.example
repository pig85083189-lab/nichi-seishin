# 在 Vercel Project Settings → Environment Variables 設定。
# 勾選 Production（必要時 Preview / Development 也勾）。
# 改完變數後必須 Redeploy，函式才讀得到新值。
# 不要把真實金鑰提交到 GitHub。

# 建議：OpenAI 官方 API
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 或者改用 OpenRouter（二選一即可）
# OPENROUTER_API_KEY=sk-or-replace-me
# OPENAI_MODEL=openai/gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# 週月報排程（可選）：接上 Vercel KV 後，Cron 才能在沒開網頁時讀到復盤並存報告。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# CRON_SECRET=replace-me

# Google 登入（OAuth）
# 授權重新導向 URI 必須完全一致（不要多斜線）：
# https://nichi-seishin.vercel.app/api/auth/callback
# AUTH_URL=https://nichi-seishin.vercel.app
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET=請填一段夠長的隨機字串

# Supabase Auth（Google 登入）
# 在 Supabase Project Settings → API 複製 URL 與 anon public key。
# 請先在 SQL Editor 執行 supabase/schema.sql
# Authentication → Providers 開啟 Google，填入 Google Cloud 的 Client ID / Secret。
# Authentication → URL Configuration：
#   Site URL = https://nichi-seishin.vercel.app
#   Redirect URLs 必須包含：
#     https://nichi-seishin.vercel.app/**
#     https://nichi-seishin.vercel.app/auth/callback.html
# Google Cloud Authorized redirect URIs 必須是（不是網站網址）：
#   https://zmjfbdtwxuawebwnybfp.supabase.co/auth/v1/callback
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# 藍新金流（NewebPay MPG）
# HashKey 必須 32 碼、HashIV 必須 16 碼，從藍新後台「商店管理 → 商店資料設定 → 串接設定」複製。
# NEWEBPAY_ENV=test 走測試刷卡頁 https://ccore.newebpay.com/MPG/mpg_gateway
# NEWEBPAY_ENV=prod 走正式刷卡頁 https://core.newebpay.com/MPG/mpg_gateway
# NotifyURL 固定為：https://nichi-seishin.vercel.app/api/pay/notify
# NEWEBPAY_MERCHANT_ID=
# NEWEBPAY_HASH_KEY=
# NEWEBPAY_HASH_IV=
# NEWEBPAY_ENV=test
# NEWEBPAY_AMT=100
# NEWEBPAY_ITEM_DESC=日精進
