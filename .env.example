# 在 Vercel Project Settings → Environment Variables 設定。
# 勾選 Production（必要時 Preview / Development 也勾）。
# 改完變數後必須 Redeploy，函式才讀得到新值。
# 不要把真實金鑰提交到 GitHub。

# 建議：OpenAI 官方 API
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 或者改用 OpenRouter（二選一即可）
# OPENROUTER_API_KEY=sk-or-replace-me
# OPENAI_MODEL=openai/gpt-4o-mini
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# 週月報排程（可選）：接上 Vercel KV 後，Cron 才能在沒開網頁時讀到復盤並存報告。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# CRON_SECRET=replace-me

# Google 登入（OAuth）
# 在 Google Cloud Console 建立 OAuth 用戶端，授權重新導向 URI 填：
# https://你的網域/api/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET=請填一段夠長的隨機字串
